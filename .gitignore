# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/scripts/migrate/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/playwright-report
/test-results

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# IDE & local agent settings (machine-specific)
.claude/settings.local.json

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env — secrets (do not commit)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.vercel.production
.env.vercel.*
.env.example
.env copy.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# validation reports
scripts/validate/output/
.tmp-*
.preview-brand-assets/

# local Supabase CLI
supabase/.temp

# Capacitor Android — machine-local IDE/SDK paths and build outputs
# Tracked: Gradle wrappers, *.gradle, gradle.properties, app/src/** (Java, res, manifest)
android/.gradle/
android/**/build/
android/local.properties
android/.idea/
android/**/*.iml
android/.externalNativeBuild/
android/.cxx/
android/captures/
android/.navigation/
# Regenerated by `npx cap sync` (not hand-edited project source)
android/capacitor-cordova-android-plugins/
android/app/src/main/assets/public/
android/app/src/main/assets/capacitor.config.json
android/app/src/main/assets/capacitor.plugins.json
android/app/src/main/res/xml/config.xml

.vercel

.env*
