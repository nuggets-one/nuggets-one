    "backfill:card-preview": "npm --prefix scripts/migrate run backfill:card-preview",
    "backfill:legacy-media": "npm --prefix scripts/migrate run backfill:legacy-media",
    "backfill:legacy-galleries": "npm --prefix scripts/migrate run backfill:legacy-media",
    "backfill:missing-previews": "npm --prefix scripts/migrate run backfill:missing-previews",
    "backfill:cloudinary-heroes": "npm --prefix scripts/migrate run backfill:cloudinary-heroes",
    "icons:generate": "node scripts/generate-brand-icons.mjs",
    "validate:og": "node scripts/validate-og.mjs",
    "check:banned-imports": "node scripts/check-banned-imports.mjs",
    "check:bundle-budget": "node scripts/check-bundle-budget.mjs",
