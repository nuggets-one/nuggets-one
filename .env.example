# Supabase — get these from Supabase dashboard > Settings > API
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<your-anon-key>
SUPABASE_SERVICE_ROLE_KEY=<your-service-role-key>

# Supabase — public vars (same values as above, exposed to browser)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<your-anon-key>

# Database — direct connection URI (Supabase > Settings > Database > URI)
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Cloudinary — required for image optimization
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=<your-cloud-name>

# Temporary — loader validation only (delete after PR-04)
# NEXT_PUBLIC_CLOUDINARY_TEST_URL=https://res.cloudinary.com/<cloud>/image/upload/<public_id>.jpg
