# Supabase — get these from Supabase dashboard > Settings > API
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<your-anon-key>
SUPABASE_SERVICE_ROLE_KEY=<your-service-role-key>

# Supabase — public vars (same values as above, exposed to browser)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<your-anon-key>

# Database — direct connection URI (Supabase > Settings > Database > URI)
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Cloudinary — required for image optimization
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=<your-cloud-name>

# Canonical site URL — used for OG tags and absolute canonical links
# Local: http://localhost:3010 (see npm run dev port in package.json)
# Production: https://nuggets.one
NEXT_PUBLIC_SITE_URL=https://nuggets.one

# Capacitor Android hosted-Web mode URL (recommended to match production site)
CAPACITOR_SERVER_URL=https://nuggets.one

# Temporary — loader validation only (delete after PR-04)
# NEXT_PUBLIC_CLOUDINARY_TEST_URL=https://res.cloudinary.com/<cloud>/image/upload/<public_id>.jpg

# Cron authentication — generate with: openssl rand -hex 32
CRON_SECRET=<generate-with-openssl-rand-hex-32>

# Firebase browser push (FCM Web SDK) — from Firebase Console > Project settings > Web app
# Canonical names (preferred):
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_VAPID_KEY=
# Legacy names also supported at build if copied verbatim from Firebase config snippet:
# apiKey= authDomain= projectId= messagingSenderId= appId=

# FCM server send + topic sync (Android + browser) — service account JSON, base64 or raw
FCM_SERVICE_ACCOUNT_JSON=

# Google Analytics 4 Measurement ID (G-XXXXXXXXXX)
# Get from: analytics.google.com → Admin → Data Streams → Web stream → Measurement ID
# Leave empty in dev/staging if you don't want local hits in GA
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# OG validator paths (comma-separated). Include home + at least one article before launch.
# Example: /,/nuggets/00000000-0000-0000-0000-000000000000/example-slug
OG_PATHS=/
