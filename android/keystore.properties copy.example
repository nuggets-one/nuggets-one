# Copy to android/keystore.properties (gitignored) for signed release/bundle builds.
# Use the same upload keystore as your first Google Play internal release.
# Windows paths: use forward slashes (C:/path/to/file.jks) — backslashes break Java Properties (\U in \Users).
storeFile=../upload-keystore.jks
storePassword=your-store-password
keyAlias=upload
keyPassword=your-key-password
